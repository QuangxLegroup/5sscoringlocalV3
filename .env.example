# App URLs and exposed ports
APP_HOST=192.168.2.61
APP_URL=https://192.168.2.61
FRONTEND_PORT=5500
BACKEND_PORT=5175
HTTPS_PORT=443
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,https://192.168.2.61

# Local JSON storage used by the current backend
DATA_FILE=runtime/main-data.json

# Auth/JWT secret for signed login sessions
# Generate using: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Database placeholders. The current app stores data in /app/data, so Docker
# Compose does not start PostgreSQL unless the backend is migrated to use it.
DATABASE_URL=postgresql://app:change-this-password@database:5432/legroup_5s?schema=public
POSTGRES_DB=legroup_5s
POSTGRES_USER=app
POSTGRES_PASSWORD=change-this-password

# Optional SMTP settings for /api/send-safety-report
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_REQUIRE_TLS=
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=LeGroup 5S
SMTP_TIMEOUT_MS=20000
