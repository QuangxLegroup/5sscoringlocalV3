# App URLs and exposed ports
APP_URL=http://192.168.2.61:5500
FRONTEND_PORT=5500
BACKEND_PORT=5175
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://192.168.2.61:5500

# Source JSON used only by the one-time PostgreSQL import. Keep this file after migration.
DATA_FILE=runtime/main-data.json

# Auth/JWT secret for signed login sessions
# Generate using: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# PostgreSQL installed on the Windows host. The migration command runs on the host.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Use credentials from the PostgreSQL installation on this machine. When all four
# POSTGRES_* values are set, they take precedence over DATABASE_URL.
POSTGRES_DB=legroup_5s
POSTGRES_USER=app
POSTGRES_PASSWORD=change-this-password
# Optional alternative when using a single connection URL instead of POSTGRES_*.
DATABASE_URL=
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000
# Set PGSSLMODE=require for a remote PostgreSQL server that requires TLS.
PGSSLMODE=disable

# Optional SMTP settings for /api/send-safety-report
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_REQUIRE_TLS=
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=LeGroup 5S
SMTP_TIMEOUT_MS=20000
